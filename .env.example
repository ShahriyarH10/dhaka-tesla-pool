# Copy to .env and adjust. NEVER commit a real .env.
# ---- database (docker compose reads these) ----
POSTGRES_USER=tesla
POSTGRES_PASSWORD=change-me-locally
POSTGRES_DB=tesla_pool

# ---- api ----
# Inside docker compose the host is "db"; outside docker use localhost.
DATABASE_URL=postgres://tesla:change-me-locally@db:5432/tesla_pool
# Set true on hosted Postgres that requires TLS (Neon, Supabase, Render external URL).
DATABASE_SSL=false
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-with-a-long-random-string
JWT_EXPIRES_IN=8h
# Comma-separated list of browser origins allowed to call the API.
CORS_ORIGIN=http://localhost:3000
LOG_LEVEL=info
# Load the Jashim/Nusrat/Rafiq/Shirin demo cast on boot (idempotent).
SEED_DEMO_DATA=true

# ---- web (baked into the Next.js bundle at build time) ----
NEXT_PUBLIC_API_URL=http://localhost:4000
